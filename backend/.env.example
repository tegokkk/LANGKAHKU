NODE_ENV=development
PORT=3001
HOST=127.0.0.1
# Optional: serve the built SPA and API from the same origin
# STATIC_DIR=../frontend/dist
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/langkahku
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/langkahku_test
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://127.0.0.1:5173
TRUST_PROXY=0
DEMO_MODE=false
RETENTION_ENABLED=false
PENDING_RETENTION_DAYS=30
# PostgreSQL binaries for local helper, backup, and restore (adjust on your machine)
PG_BIN=D:/ProgramFile/PostgreSQL/15/bin
# Required for production worker: durable ledger OUTSIDE database backups
# DELETION_LEDGER_PATH=D:/secure-state/langkahku-deletions.ndjson
# BACKUP_KEY=base64-encoded-32-random-bytes-managed-outside-source
# BACKUP_DIRECTORY=D:/secure-backups/langkahku
# BACKUP_FILE=D:/secure-backups/langkahku/selected-backup.lkb
# RESTORE_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/langkahku_restore
