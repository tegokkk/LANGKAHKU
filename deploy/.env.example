# Copy to deploy/.env, restrict read access, and replace EVERY placeholder.
DOMAIN=langkahku.example.sch.id
ACME_EMAIL=operator@example.sch.id
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
STATIC_DIR=/app/frontend/dist
APP_ORIGIN=https://langkahku.example.sch.id
# Exactly one proxy (Caddy). API and DB ports must stay unpublished.
TRUST_PROXY=1
DEMO_MODE=false
SESSION_SECRET=replace-with-random-64-hex-characters
POSTGRES_USER=langkahku_owner
POSTGRES_PASSWORD=replace-with-random-owner-password
POSTGRES_DB=langkahku
APP_DB_PASSWORD=replace-with-random-app-password
# URL-encode passwords in URLs. Runtime role is created by init-database.sh.
DATABASE_URL=postgresql://langkahku_app:APP_PASSWORD_URL_ENCODED@database:5432/langkahku
MIGRATION_DATABASE_URL=postgresql://langkahku_owner:OWNER_PASSWORD_URL_ENCODED@database:5432/langkahku
DELETION_LEDGER_PATH=/state/deletion-ledger.ndjson
PG_BIN=/usr/bin
BACKUP_DIRECTORY=/backups
BACKUP_KEY=replace-with-base64-of-32-random-bytes
# Enable only after school retention dates/policy have been approved.
RETENTION_ENABLED=false
PENDING_RETENTION_DAYS=30
